#!/usr/bin/env python3
"""Export the signed-in 1Password account to a 1PUX file. See README.md."""

import json
import os
import subprocess
import sys
import threading
import time
import zipfile
from collections import Counter
from datetime import UTC, datetime

# 1PUX category codes, as used by 1Password's exports and the importers that
# read them. 1Password's format page gives only "001".
CATEGORY_UUID = {
    "LOGIN": "001",
    "CREDIT_CARD": "002",
    "SECURE_NOTE": "003",
    "IDENTITY": "004",
    "PASSWORD": "005",
    "DOCUMENT": "006",
    "SOFTWARE_LICENSE": "100",
    "BANK_ACCOUNT": "101",
    "DATABASE": "102",
    "DRIVER_LICENSE": "103",
    "OUTDOOR_LICENSE": "104",
    "MEMBERSHIP": "105",
    "PASSPORT": "106",
    "REWARD_PROGRAM": "107",
    "SOCIAL_SECURITY_NUMBER": "108",
    "WIRELESS_ROUTER": "109",
    "SERVER": "110",
    "EMAIL_ACCOUNT": "111",
    "API_CREDENTIAL": "112",
    "MEDICAL_RECORD": "113",
    "SSH_KEY": "114",
    "CRYPTO_WALLET": "115",
}

VALUE_KEY = {
    "STRING": "string",
    "CONCEALED": "concealed",
    "OTP": "totp",
    "URL": "url",
    "PHONE": "phone",
    "MENU": "menu",
    "GENDER": "gender",
    "ADDRESS": "address",
    "REFERENCE": "reference",
    "CREDIT_CARD_NUMBER": "creditCardNumber",
    "CREDIT_CARD_TYPE": "creditCardType",
}

# op lists these as separate fields of an SSH key; 1PUX keeps them in the
# private key's value.
SSH_METADATA = {"public_key": "publicKey", "fingerprint": "fingerprint", "key_type": "keyType"}

# How the desktop app's export writes a field with no value, for types where
# it isn't an empty string.
EMPTY_VALUE = {
    "EMAIL": {"email": {"email_address": "", "provider": None}},
    "MONTH_YEAR": {"monthYear": None},
    "DATE": {"date": None},
    "ADDRESS": {"address": {"street": "", "city": "", "country": "", "zip": "", "state": ""}},
}

ACCOUNT = {
    "accountName": "",
    "name": "",
    "avatar": "",
    "email": "",
    "uuid": "",
    "domain": "https://my.1password.com/",
}


def epoch(stamp):
    return round(datetime.fromisoformat(stamp).timestamp())


def has_value(field):
    return field.get("value") not in (None, "")


def field_value(field):
    kind = field["type"]
    if not has_value(field):
        return EMPTY_VALUE.get(kind) or {VALUE_KEY[kind]: ""}
    value = field["value"]
    if kind == "EMAIL":
        return {"email": {"email_address": value, "provider": None}}
    if kind == "MONTH_YEAR":
        month, _, year = str(value).partition("/")
        return {"monthYear": int(year + month.zfill(2)) if year else int(value)}
    if kind == "DATE":
        text = str(value)
        if text.isdigit():
            return {"date": int(text)}
        return {"date": int(datetime.fromisoformat(text).replace(tzinfo=UTC).timestamp())}
    return {VALUE_KEY[kind]: value}


def section_field(title, id, value, guarded=False):
    return {
        "title": title,
        "id": id,
        "value": value,
        "guarded": guarded,
        "multiline": False,
        "dontGenerate": False,
        "inputTraits": {"keyboard": "default", "correction": "default", "capitalization": "default"},
    }


def file_attributes(file):
    return {"fileName": file["name"], "documentId": file["id"], "decryptedSize": file["size"]}


def by_purpose(fields, purpose):
    return next((f for f in fields if f.get("purpose") == purpose), None)


def convert_item(item):
    category = item["category"]
    # op lists fields it can't read, such as "Sign in with" records, as
    # UNKNOWN with no value. There is nothing in them to export.
    fields = [f for f in item.get("fields", []) if f["type"] != "UNKNOWN" or has_value(f)]
    filled = [f for f in fields if has_value(f)]
    notes = by_purpose(filled, "NOTES")
    # Only logins and passwords have dedicated places for these; elsewhere
    # they stay ordinary section fields.
    username = by_purpose(filled, "USERNAME") if category == "LOGIN" else None
    password = by_purpose(filled, "PASSWORD") if category in ("LOGIN", "PASSWORD") else None
    files = item.get("files", [])
    ssh_metadata = {}
    if category == "SSH_KEY":
        ssh_metadata = {SSH_METADATA[f["id"]]: f["value"] for f in filled if f["id"] in SSH_METADATA}
        fields = [f for f in fields if f["id"] not in SSH_METADATA]

    titles = {s["id"]: s.get("label", "") for s in item.get("sections", [])}
    sections = {}

    def add(section_id, entry):
        if section_id not in sections:
            sections[section_id] = {"title": titles.get(section_id, ""), "name": section_id, "fields": []}
        sections[section_id]["fields"].append(entry)

    for f in fields:
        if f.get("purpose") == "NOTES" or f is username or f is password:
            continue
        if f["type"] == "SSHKEY":
            value = {"sshKey": {"privateKey": f["value"], "metadata": {"privateKey": f["value"], **ssh_metadata}}}
        else:
            value = field_value(f)
        guarded = f["type"] == "SSHKEY"
        add((f.get("section") or {}).get("id", ""), section_field(f.get("label", ""), f["id"], value, guarded))

    details = {
        "loginFields": [],
        "notesPlain": notes["value"] if notes else "",
        "sections": [],
        "passwordHistory": [],
    }
    if category == "DOCUMENT":
        [document] = files
        details["documentAttributes"] = file_attributes(document)
    else:
        for file in files:
            value = {"file": file_attributes(file)}
            add((file.get("section") or {}).get("id", ""), section_field(file["name"], file["id"], value))
    details["sections"] = list(sections.values())

    if category == "LOGIN":
        for f, designation, field_type in ((username, "username", "T"), (password, "password", "P")):
            if f:
                details["loginFields"].append(
                    {"value": f["value"], "id": "", "name": f["label"], "fieldType": field_type, "designation": designation}
                )
    elif password:
        details["password"] = password["value"]

    urls = [{"label": u.get("label", ""), "url": u["href"]} for u in item.get("urls", [])]
    primary = next((u["href"] for u in item.get("urls", []) if u.get("primary")), urls[0]["url"] if urls else "")
    return {
        "uuid": item["id"],
        "favIndex": 1 if item.get("favorite") else 0,
        "createdAt": epoch(item["created_at"]),
        "updatedAt": epoch(item["updated_at"]),
        "state": "archived" if item.get("state") == "ARCHIVED" else "active",
        # op reports categories it has no name for as CUSTOM, with their code.
        "categoryUuid": item["category_id"] if category == "CUSTOM" else CATEGORY_UUID[category],
        "overview": {
            "title": item["title"],
            "subtitle": username["value"] if username else "",
            "url": primary,
            "urls": urls,
            "tags": item.get("tags", []),
        },
        "details": details,
    }


def build(items):
    vaults = {}
    for item in items:
        vault = item["vault"]
        target = vaults.setdefault(
            vault["id"],
            {"attrs": {"uuid": vault["id"], "desc": "", "avatar": "", "name": vault["name"], "type": "U"}, "items": []},
        )
        target["items"].append(convert_item(item))
    return {"accounts": [{"attrs": ACCOUNT, "vaults": list(vaults.values())}]}


def read_items(lines):
    """Yield the items of `op item get -` output, one JSON object per item,
    back to back, each as soon as its last line arrives."""
    decoder = json.JSONDecoder()
    text = ""
    for line in lines:
        text += line
        while text := text.lstrip():
            try:
                item, end = decoder.raw_decode(text)
            except json.JSONDecodeError:
                break  # The item's remaining lines haven't arrived yet.
            yield item
            text = text[end:]
    if text:
        raise json.JSONDecodeError("op output ends inside an item", text, len(text))


def write_1pux(path, data, files):
    """Write the archive at mode 0600. `files` maps a document ID to (file name, contents)."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    attributes = {"version": 3, "description": "1Password Unencrypted Export", "timestamp": int(time.time())}
    with os.fdopen(fd, "wb") as handle, zipfile.ZipFile(handle, "w", zipfile.ZIP_DEFLATED) as archive:
        archive.writestr("export.attributes", json.dumps(attributes))
        archive.writestr("export.data", json.dumps(data))
        for document_id, (name, contents) in files.items():
            archive.writestr(f"files/{document_id}__{name}", contents)


def op(*args, input=None):
    return subprocess.run(["op", *args], input=input, stdout=subprocess.PIPE, check=True).stdout


def op_lines(*args, input):
    """Yield op's output line by line as it arrives."""
    with subprocess.Popen(["op", *args], stdin=subprocess.PIPE, stdout=subprocess.PIPE) as proc:

        def feed():
            proc.stdin.write(input)
            proc.stdin.close()

        # Feed stdin from a thread, so op can't stall on a full stdout pipe
        # while input is still being written.
        threading.Thread(target=feed).start()
        for line in proc.stdout:
            yield line.decode()
    if proc.returncode:
        raise subprocess.CalledProcessError(proc.returncode, proc.args)


def progress(label, done, total):
    if sys.stderr.isatty():
        print(f"\r{label} {done}/{total}", end="\n" if done == total else "", file=sys.stderr, flush=True)


def default_name():
    account = json.loads(op("whoami", "--format=json"))["account_uuid"]
    return f"1PasswordExport-{account}-{time.strftime('%Y%m%d-%H%M%S')}.1pux"


def main(out=None):
    out = out or default_name()
    if not out.endswith(".1pux"):
        sys.exit(f"{out}: name must end in .1pux")
    if os.path.exists(out):
        sys.exit(f"{out}: already exists")
    listing = op("item", "list", "--include-archive", "--format=json")
    total = len(json.loads(listing))
    items = []
    for item in read_items(op_lines("item", "get", "-", "--format=json", input=listing)):
        items.append(item)
        progress("items", len(items), total)
    data = build(items)
    refs = [(file, f"op://{item['vault']['id']}/{item['id']}/{file['id']}") for item in items for file in item.get("files", [])]
    files = {}
    for file, ref in refs:
        files[file["id"]] = (file["name"], op("read", "--no-newline", "--force", ref))
        progress("files", len(files), len(refs))
    write_1pux(out, data, files)
    for category, count in sorted(Counter(i["category"] for i in items).items()):
        print(f"{count:5} {category}")
    print(f"{len(files):5} files")


if __name__ == "__main__":
    main(*sys.argv[1:])
